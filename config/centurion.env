# ============================================================================
#  Centurion - configuracion de entorno (local / Docker)
#  Lo consume docker-compose.yml (env_file) para los 3 servicios.
#  Para otro entorno: copia este archivo y cambia credenciales/host.
# ============================================================================

# --- Contenedor MySQL (servicio "db") --------------------------------------
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=controlnode
MYSQL_USER=centurion
MYSQL_PASSWORD=centurion

# --- Datasource JTA de la app (TomEE, id = jdbc/controlNode) --------------
#  El entrypoint sustituye estas variables dentro de conf/tomee.xml.
DB_URL=jdbc:mysql://db:3306/controlnode?useSSL=false
DB_USER=centurion
DB_PASSWORD=centurion

# --- Mock SOAP OpticalWS (servicio "opticalws") -> conexion a la BD -------
DB_HOST=db
DB_PORT=3306
DB_NAME=controlnode
OPTICALWS_PORT=81
